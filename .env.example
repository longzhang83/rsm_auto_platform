# 多账户GLM翻译服务配置示例
# 复制此文件为 .env 并填入实际配置

# =============================================================================
# GLM API 密钥配置
# =============================================================================

# 方式1: 使用多个API密钥（推荐，支持负载均衡）
# 用逗号分隔多个API密钥，系统会自动分配任务
ZHIPUAI_API_KEYS=your_first_api_key_here,your_second_api_key_here,your_third_api_key_here

# 方式2: 使用单个API密钥（向后兼容）
# ZHIPUAI_API_KEY=your_single_api_key_here

# GLM模型配置
# 可选模型：
# - glm-4: 通用模型，平衡性能和质量
# - glm-4-plus: 增强版模型，质量更高但速度较慢
# - glm-4-flash: 快速模型，适合大批量翻译
# - glm-4-long: 长文本模型，支持更长的上下文
# - glm-4-air: 经济型模型，成本更低
# - glm-4-airx: 经济增强型模型
# - glm-4.5-flash: 最新快速模型（推荐）
ZHIPUAI_MODEL=glm-4.5-flash

# GLM系统提示词配置（可选）
# 可以自定义翻译风格和要求
ZHIPUAI_SYSTEM_PROMPT=你是一名专业的双语助理，请提供准确、简洁的翻译结果。

# =============================================================================
# 翻译服务配置
# =============================================================================

# 翻译缓存文件路径
TRANSLATION_MAP_PATH=data/translation_mapping.csv

# 单个账户的速率限制（请求/秒）
ZHIPUAI_RPS=0.6

# =============================================================================
# 应用配置
# =============================================================================

# 应用环境 (development/production)
ENVIRONMENT=development

# 调试模式
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=8888

# =============================================================================
# 数据库配置（如果使用）
# =============================================================================

# DATABASE_URL=sqlite:///./data/app.db

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 日志输出配置
LOG_ENABLE_CONSOLE=true        # 是否启用控制台输出
LOG_ENABLE_FILE=true          # 是否启用文件输出
LOG_ENABLE_JSON=false         # 是否启用JSON格式日志
LOG_COLORED_CONSOLE=true      # 控制台是否显示颜色

# 日志文件配置
LOG_MAX_FILE_SIZE=10485760    # 单个日志文件最大大小（10MB）
LOG_BACKUP_COUNT=5            # 日志文件备份数量
LOG_RETENTION_DAYS=30         # 日志保留天数

# 日志目录（相对于项目根目录）
# LOG_DIR=logs                 # 可选：自定义日志目录

# =============================================================================
# 性能优化配置
# =============================================================================

# 翻译工作线程数（每个账户）
TRANSLATION_MAX_WORKERS=3

# 批量翻译时的请求速率限制
TRANSLATION_REQUESTS_PER_SECOND=0.6

# =============================================================================
# 文件上传配置
# =============================================================================

# 最大文件大小（字节）
MAX_FILE_SIZE=52428800  # 50MB

# 允许的文件扩展名（多个用逗号分隔）
# 注意：必须包含点号（.）前缀
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv

# =============================================================================
# 应用个性化配置
# =============================================================================

# 应用名称（显示在前端标题等位置）
APP_NAME=容诚税务自动化平台

# 默认制单人
DEFAULT_PREPARER=cissy

# 默认凭证类别
DEFAULT_VOUCHER_CATEGORY=记

# 默认贷方科目
DEFAULT_CREDIT_ACCOUNT=224104

# =============================================================================
# 邮箱服务器配置（用于发送验证码）
# =============================================================================

# SMTP服务器地址
# 常见邮箱服务器：
# - QQ邮箱：smtp.qq.com
# - 163邮箱：smtp.163.com
# - Gmail：smtp.gmail.com
# - 企业邮箱：根据实际情况配置
SMTP_SERVER=smtp.qq.com

# SMTP服务器端口
# - 587: STARTTLS加密（推荐）
# - 465: SSL加密
# - 25: 无加密（不推荐）
SMTP_PORT=587

# SMTP用户名（通常是发件人邮箱地址）
# 示例：your-email@qq.com
SMTP_USERNAME=your-email@qq.com

# SMTP密码或授权码
# 注意：QQ邮箱、163邮箱等需要使用"授权码"而非登录密码
# 如何获取QQ邮箱授权码：
# 1. 登录QQ邮箱 -> 设置 -> 账户
# 2. 找到"POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务"
# 3. 开启"IMAP/SMTP服务"
# 4. 生成授权码
SMTP_PASSWORD=your-authorization-code

# 发件人显示名称
EMAIL_FROM_NAME=容诚税务师事务所

# =============================================================================
# 邮箱验证码配置
# =============================================================================

# 允许注册的邮箱域名（多个域名用逗号分隔）
# 示例：rsmchina.com.cn,example.com
ALLOWED_EMAIL_DOMAINS=rsmchina.com.cn

# 验证码有效期（秒）
# 默认：300秒（5分钟）
VERIFICATION_CODE_EXPIRY=300

# 验证码长度（数字位数）
# 默认：6位数字
VERIFICATION_CODE_LENGTH=6

# =============================================================================
# 企业微信登录配置
# =============================================================================

# 是否启用企业微信登录
# true: 启用  false: 禁用
WEWORK_ENABLED=false

# 企业ID（从企业微信管理后台获取）
# 示例：ww1234567890abcdef
WEWORK_CORP_ID=your_corp_id_here

# 应用ID（从企业微信自建应用获取）
# 示例：1000002
WEWORK_AGENT_ID=your_agent_id_here

# 应用密钥（从企业微信自建应用获取）
# 注意：密钥需要保密，不要泄露
WEWORK_SECRET=your_secret_here

# 回调URL（企业微信授权后的回调地址）
# 开发环境示例：http://localhost:3000/auth/wework/callback
# 生产环境示例：https://yourdomain.com/auth/wework/callback
# 注意：此URL需要在企业微信管理后台配置可信域名
WEWORK_CALLBACK_URL=http://localhost:3000/auth/wework/callback

# =============================================================================
# 部署配置
# =============================================================================

# 部署模式：使用nginx作为反向代理，后端仅提供API服务